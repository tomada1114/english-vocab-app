# Copy this file to .env and fill in what you need. Every name below is
# declared in src/server/env.ts, which is the only place this application
# reads process.env; tests/server-env.test.ts fails when the two drift apart.

# Shared secret a caller of a billed endpoint must send as `Authorization:
# Bearer <value>`. Optional today: this application wires nothing that bills a
# provider, so readServerEnv never requires it -- see src/server/env.ts's
# ServerEnvRequirements for when it becomes mandatory. It buys authentication
# only: this template ships no rate limit.
API_ACCESS_KEY=

# Where the SQLite file holding your review history lives. Optional: leaving it
# blank uses `.data/english-vocab.sqlite`, relative to the working directory,
# which src/server/db/connection.ts creates on first open. Point it elsewhere to
# keep a second checkout's database apart from this one's.
VOCAB_DB_PATH=
